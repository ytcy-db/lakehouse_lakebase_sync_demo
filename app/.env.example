# app/.env にコピーして、接続先のワークスペースに合わせて書き換える
# Databricks CLI のプロファイル名（databricks auth login --host <WS URL> --profile <名前> で作成）
DATABRICKS_PROFILE=<your-profile>
# サーバーレス SQL ウェアハウスの ID
WAREHOUSE_ID=<warehouse-id>
# Lakebase プロジェクト（ブランチ production / エンドポイント primary / DB databricks_postgres を使用）
LB_PROJECT=survey-sync-demo
# 製品マスタと CDF 履歴テーブルを置く UC カタログ・スキーマ
# ※ カタログはデフォルトストレージ以外（外部ロケーション等）であること（Lakebase CDF の制約）
UC_CATALOG=<catalog>
UC_SCHEMA=survey_sync_demo
